---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';

const pioneers = (await getCollection('pioneers')).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(
	pioneers.map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content }))
);
---

<BaseLayout title="Web Pioneers">
	<div class="max-w-5xl mx-auto p-6">
		<h1 class="text-4xl font-bold mb-8 text-center">Web Pioneers</h1>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{cards.map(({ name, image, link, linkText, Content }) => (
				<PersonCard name={name} image={image} link={link} linkText={linkText}>
					<Content />
				</PersonCard>
			))}
		</div>
	</div>
</BaseLayout>
