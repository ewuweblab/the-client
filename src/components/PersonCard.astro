---
const { name, image, link, linkText } = Astro.props;
---

<article class="bg-white rounded-lg shadow overflow-hidden">
	<img class="w-full aspect-[4/3] object-cover object-top" src={image} alt={name} />
	<div class="p-4">
		<h2 class="text-xl font-semibold">{name}</h2>
		<p class="mt-2 text-sm"><slot /></p>
		<a class="mt-3 inline-block text-blue-600 underline" href={link}>{linkText}</a>
	</div>
</article>
